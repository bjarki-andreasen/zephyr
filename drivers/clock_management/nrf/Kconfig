config CLOCK_MANAGEMENT_NRF
	bool

config CLOCK_MANAGEMENT_NRF_FIXED_FACTOR
	bool "nRF Fixed factor clock driver"
	default y
	depends on DT_HAS_NORDIC_NRF_FIXED_FACTOR_ENABLED
	select CLOCK_MANAGEMENT_NRF

config CLOCK_MANAGEMENT_NRF_HFPLL_MUX
	bool "nRF HFPLL mux clock driver"
	default y
	depends on DT_HAS_NORDIC_NRF_HFPLL_MUX_ENABLED
	select CLOCK_MANAGEMENT_NRF
	select NRFX_CLOCK_XO

config CLOCK_MANAGEMENT_NRF_LFCLK_MUX
	bool "nRF LFCLK mux clock driver"
	default y
	depends on DT_HAS_NORDIC_NRF_LFCLK_MUX_ENABLED
	select CLOCK_MANAGEMENT_NRF
	select NRFX_CLOCK_LFCLK
