# Enable MPU
CONFIG_ARM_MPU=y

# Enable TrustZone-M
CONFIG_ARM_TRUSTZONE_M=y

# This Board implies building Non-Secure firmware based on TF-M
CONFIG_TRUSTED_EXECUTION_NONSECURE=y
CONFIG_SOC_TEE_GPIO_PIN_MCU_SELECT_CUSTOM=y

# enable GPIO
CONFIG_GPIO=y

# Enable uart driver
CONFIG_SERIAL=y

# enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
